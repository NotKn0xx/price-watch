# Credenciales del bot de Telegram (obligatorias para que envie alertas).
# Sin ellas run.py imprime las alertas por consola en vez de enviarlas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Perfil a escanear: perfumes | hardware | celulares
PROFILE=perfumes

# Archivo SQLite con el historial de precios.
DB_PATH=price_watch_perfumes.db

# 1 = escanea y detecta, pero imprime las alertas en vez de enviarlas
# y no las registra en la base. Util para calibrar umbrales.
DRY_RUN=
